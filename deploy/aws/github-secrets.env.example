# ALL GitHub secrets used by the AWS staging deployment.
# Private working copy: /home/eranda/Projects/doc-craft/.env.deployment
# Each top-level NAME below is a GitHub Actions secret with the same name.
# Import the completed file using:
# gh secret set --repo senyx-software/Doc-Craft --env aws-staging --env-file .env.deployment
# This is dotenv data, not a shell script. Leave unused optional keys empty.

# REQUIRED: existing IAM user credentials for Terraform and EC2 deployment.
# Keep these in GitHub Secrets for future staging releases.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only when the AWS credentials are temporary:
AWS_SESSION_TOKEN=

# REQUIRED: server connection. Local private copy contains the actual PEM/key.
AWS_STAGING_SSH_USER=ubuntu
AWS_STAGING_SSH_KEY='PASTE_THE_COMPLETE_MULTILINE_PEM_HERE'
AWS_STAGING_KNOWN_HOSTS='i-098228a0d829d7eb2 ssh-ed25519 REPLACE_WITH_VERIFIED_HOST_PUBLIC_KEY'
# Your public IPv4/VPN networks as a JSON array. Protects admin HTTPS port 8443.
AWS_STAGING_ADMIN_CIDRS='["REPLACE_WITH_YOUR_PUBLIC_IP/32"]'

# REQUIRED: initial administrator and real email delivery for login/verification.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# REQUIRED: contact email for automatically renewed public-IP HTTPS certificates.
ACME_EMAIL=

# Deployment configuration version. Existing installs require operator-controlled
# config/credential updates; changing this alone does not rotate secrets.
CONFIG_VERSION=aws-staging-1

# OPTIONAL: AI providers. Enable/configure managed AI in admin after deployment.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# OPTIONAL: Google/Firebase sign-in. Provider authorization/callback rules apply.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the Firebase web project configured in the user UI.
FIREBASE_PROJECT_ID=doc-craft-57643

# OPTIONAL: Supabase document storage. Default deployment uses a private volume.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LEGACY_STORAGE_PROVIDER=

# OPTIONAL: Paddle TEST/SANDBOX credentials and price IDs.
# Staging forces PADDLE_SANDBOX=true and PAYHERE_SANDBOX=true.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRO_MONTHLY_PRICE_ID=
PADDLE_PRO_YEARLY_PRICE_ID=
PADDLE_MAX_MONTHLY_PRICE_ID=
PADDLE_MAX_YEARLY_PRICE_ID=

# OPTIONAL: PayHere sandbox.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=

# OPTIONAL: PostHog analytics and experiment reports.
POSTHOG_API_KEY=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=

# Automatically generated on EC2; no manual GitHub values are needed:
# DATABASE_URL, DIRECT_URL, ADMIN_DATABASE_URL, REDIS_URL,
# JWT_SECRET, JWT_REFRESH_SECRET, ADMIN_JWT_SECRET,
# PostgreSQL/Redis passwords, service signing/identity keys,
# private TLS keys, TOTP encryption keys and the AI credential keyring.
# GITHUB_TOKEN is automatically supplied by GitHub Actions.
# The app uses https://<Elastic-IP> and admin https://<Elastic-IP>:8443.
# APP_DOMAIN, ADMIN_DOMAIN and internal service URLs are generated by the workflow.
# Repository VARIABLE (not secret): AWS_STAGING_DEPLOY_ENABLED=true after setup.
