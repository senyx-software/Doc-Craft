{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DiscoverGitHubIdentityProvider",
      "Effect": "Allow",
      "Action": "iam:ListOpenIDConnectProviders",
      "Resource": "*"
    },
    {
      "Sid": "ConfigureGitHubIdentityProvider",
      "Effect": "Allow",
      "Action": [
        "iam:CreateOpenIDConnectProvider",
        "iam:GetOpenIDConnectProvider",
        "iam:ListOpenIDConnectProviderTags",
        "iam:TagOpenIDConnectProvider",
        "iam:AddClientIDToOpenIDConnectProvider",
        "iam:RemoveClientIDFromOpenIDConnectProvider",
        "iam:UpdateOpenIDConnectProviderThumbprint"
      ],
      "Resource": "arn:aws:iam::506192652462:oidc-provider/token.actions.githubusercontent.com"
    },
    {
      "Sid": "ConfigureStagingGitHubRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:TagRole",
        "iam:UpdateRole",
        "iam:UpdateRoleDescription",
        "iam:UpdateAssumeRolePolicy",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies"
      ],
      "Resource": "arn:aws:iam::506192652462:role/doccraft-staging-github"
    },
    {
      "Sid": "ManageStagingStateBucket",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::doccraft-staging-tfstate-506192652462-ap-southeast-2",
        "arn:aws:s3:::doccraft-staging-tfstate-506192652462-ap-southeast-2/*"
      ]
    },
    {
      "Sid": "ReadSydneyInstanceConfiguration",
      "Effect": "Allow",
      "Action": "ec2:Describe*",
      "Resource": "*",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "ap-southeast-2" }
      }
    },
    {
      "Sid": "VerifyCaller",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    }
  ]
}
