{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::doccraft-staging-tfstate-506192652462-ap-southeast-2",
        "arn:aws:s3:::doccraft-staging-tfstate-506192652462-ap-southeast-2/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:ModifyNetworkInterfaceAttribute",
        "ec2:AssociateAddress",
        "ec2:DisassociateAddress"
      ],
      "Resource": [
        "arn:aws:ec2:ap-southeast-2:506192652462:instance/i-098228a0d829d7eb2",
        "arn:aws:ec2:ap-southeast-2:506192652462:network-interface/eni-04a692c318cf01ebb",
        "arn:aws:ec2:ap-southeast-2:506192652462:elastic-ip/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup",
        "ec2:AllocateAddress"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:RequestTag/Application": "doccraft",
          "aws:RequestTag/Environment": "staging"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:ap-southeast-2:506192652462:*/*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "CreateSecurityGroup",
            "AllocateAddress",
            "AuthorizeSecurityGroupIngress",
            "AuthorizeSecurityGroupEgress"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:DeleteSecurityGroup",
        "ec2:ReleaseAddress"
      ],
      "Resource": "arn:aws:ec2:ap-southeast-2:506192652462:*/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Application": "doccraft",
          "aws:ResourceTag/Environment": "staging"
        }
      }
    }
  ]
}
