# GitHub environment secret AWS_STAGING_CONFIG. Keep these placeholders literally;
# the workflow replaces them with the observed Elastic IP and ADMIN_CIDRS secret.
APP_DOMAIN=__PUBLIC_IP__
ADMIN_DOMAIN=__PUBLIC_IP__:8443
ADMIN_ALLOWED_CIDRS=__ADMIN_CIDRS__
ACME_EMAIL=ops@example.com
RESEND_FROM_EMAIL=notifications@example.com
CONFIG_VERSION=aws-staging-1
REGISTRY_PREFIX=ghcr.io/senyx-software/doccraft
POSTGRES_DB=doccraft_aws_staging
LOCAL_AI_ENABLED=false
PADDLE_SANDBOX=true
PAYHERE_SANDBOX=true
MAX_CONCURRENT_REQUESTS=2
MAX_QUEUE_SIZE=8
PDF_MAX_CONCURRENT=1
