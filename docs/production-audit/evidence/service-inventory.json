  {
    "name": "postgres",
    "source_directory": "deploy",
    "runtime": "postgres",
    "framework": "upstream infrastructure",
    "build_command": "Pull pinned image / deploy Dockerfile target",
    "startup": [
      "postgres",
      "-c",
      "ssl=on",
      "-c",
      "ssl_cert_file=/run/doccraft-tls/server.crt",
      "-c",
      "ssl_key_file=/run/doccraft-tls/server.key",
      "-c",
      "ssl_min_protocol_version=TLSv1.2",
      "-c",
      "hba_file=/control/deploy/staging/pg_hba.conf",
      "-c",
      "shared_buffers=128MB",
      "-c",
      "max_connections=160"
    ],
    "port": 5432,
    "exposure": "private/edge-routed or tools-profile job",
    "database": "none",
    "redis": "none",
    "internal_dependencies": {},
    "external_dependencies": "see source edge inventory",
    "health": [
      "CMD",
      "pg_isready",
      "-U",
      "postgres",
      "-d",
      "${POSTGRES_DB:?}"
    ],
    "authentication": "TLS/ACL",
    "required_configuration": [],
    "required_secrets": [
      "postgres_password",
      "postgres_crt",
      "postgres_key",
      "postgres_migrator_password"
    ],
    "resource_caps": {
      "memory": "1536m",
      "cpus": 1.5
    },
    "volumes": [
      "postgres:/var/lib/postgresql/data",
      "${DOCCRAFT_CONTROL:?}:/control:ro",
      "${DOCCRAFT_CONTROL:?}/deploy/scripts/bootstrap-postgres.sh:/docker-entrypoint-initdb.d/01-doccraft.sh:ro"
    ],
    "profile": []
  },
  {
    "name": "redis",
    "source_directory": "deploy",
    "runtime": "redis",
    "framework": "upstream infrastructure",
    "build_command": "Pull pinned image / deploy Dockerfile target",
    "startup": [
      "redis-server",
      "--port",
      "0",
      "--tls-port",
      "6379",
      "--tls-cert-file",
      "/run/secrets/redis.crt",
      "--tls-key-file",
      "/run/secrets/redis.key",
      "--tls-ca-cert-file",
      "/run/secrets/ca.crt",
      "--tls-auth-clients",
      "no",
      "--aclfile",
      "/run/secrets/redis.acl",
      "--appendonly",
      "yes",
      "--appendfsync",
      "always",
      "--maxmemory",
      "256mb",
      "--maxmemory-policy",
      "noeviction"
    ],
    "port": 6379,
    "exposure": "private/edge-routed or tools-profile job",
    "database": "none",
    "redis": "persistent Redis service",
    "internal_dependencies": {},
    "external_dependencies": "see source edge inventory",
    "health": [
      "CMD",
      "redis-cli",
      "--tls",
      "--cacert",
      "/run/secrets/ca.crt",
      "--user",
      "health",
      "ping"
    ],
    "authentication": "TLS/ACL",
    "required_configuration": [],
    "required_secrets": [
      "ca",
      "redis_crt",
      "redis_key",
      "redis_acl"
    ],
    "resource_caps": {
      "memory": "384m",
      "cpus": 0.5
    },
    "volumes": [
      "redis:/data"
    ],
    "profile": []
  },
