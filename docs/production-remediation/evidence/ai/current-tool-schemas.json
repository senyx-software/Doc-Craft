  {
    "type": "function",
    "function": {
      "name": "edit_canvas",
      "description": "Apply evidenced visual changes to selected elements or the unique document heading. Style, move, resize, remove or add supported visual elements. For business text and amounts use update_slots instead. Ambiguous targets require selecting an element. Never change a property the user did not request.",
      "parameters": {
        "type": "object",
        "properties": {
          "operations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "enum": [
                    "update",
                    "remove",
                    "add"
                  ]
                },
                "target": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "selected",
                        "heading",
                        "element"
                      ]
                    },
                    "id": {
                      "type": "string",
                      "maxLength": 160
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false
                },
                "patch": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "w": {
                      "type": "number"
                    },
                    "h": {
                      "type": "number"
                    },
                    "rotation": {
                      "type": "number"
                    },
                    "opacity": {
                      "type": "number"
                    },
                    "fontSize": {
                      "type": "number"
                    },
                    "fontWeight": {
                      "type": "number"
                    },
                    "fontFamily": {
                      "type": "string",
                      "maxLength": 160
                    },
                    "color": {
                      "type": "string",
                      "maxLength": 160
                    },
                    "fill": {
                      "type": "string",
                      "maxLength": 160
                    },
                    "stroke": {
                      "type": "string",
                      "maxLength": 160
                    },
                    "strokeWidth": {
                      "type": "number"
                    },
                    "align": {
                      "type": "string",
                      "maxLength": 160
                    },
                    "italic": {
                      "type": "boolean"
                    },
                    "underline": {
                      "type": "boolean"
                    },
                    "hidden": {
                      "type": "boolean"
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 1000
                    },
                    "scale": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": false
                },
                "element": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "text",
                        "rect",
                        "ellipse",
                        "line"
                      ]
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 1000
                    },
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "w": {
                      "type": "number"
                    },
                    "h": {
                      "type": "number"
                    },
                    "fill": {
                      "type": "string"
                    },
                    "color": {
                      "type": "string"
                    },
                    "fontSize": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "type",
                    "x",
                    "y",
                    "w",
                    "h"
                  ],
                  "additionalProperties": false
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "required": [
                "operation",
                "evidence"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "operations"
        ],
        "additionalProperties": false
      }
    }
  },
