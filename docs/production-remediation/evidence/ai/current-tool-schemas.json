[
  {
    "type": "function",
    "function": {
      "name": "update_slots",
      "description": "Propose document field updates supported by literal evidence from the current user message. No inferred quantities or prices. Only explicit corrections may replace confirmed facts. Use requestField with literal field-label evidence to persist a user request for an optional/existing field before asking its value. Use itemOperations for add/update/remove with stable IDs; fieldOperations supports set/append/clear/skip. Notes and payment terms are distinct. Persist genuine pending operations using confirmBeforeApply before asking yes/no.",
      "parameters": {
        "type": "object",
        "properties": {
          "confirmBeforeApply": {
            "type": "boolean",
            "description": "Only when a genuinely ambiguous supported edit needs user approval; persist the validated proposal before asking."
          },
          "confirmationQuestion": {
            "type": "string"
          },
          "fieldOperations": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "operation": {
                  "enum": [
                    "set",
                    "append",
                    "clear",
                    "skip"
                  ]
                },
                "field": {
                  "type": "string",
                  "enum": [
                    "businessName",
                    "clientName",
                    "invoiceNumber",
                    "issueDate",
                    "dueDate",
                    "lineItems",
                    "currency",
                    "senderAddress",
                    "senderEmail",
                    "senderPhone",
                    "clientAddress",
                    "clientEmail",
                    "clientPhone",
                    "subject",
                    "businessServices",
                    "taxRate",
                    "notesAndTerms",
                    "accountDetails",
                    "locale",
                    "dateFormat",
                    "taxStatus",
                    "discountRate",
                    "paymentMethod",
                    "senderTaxId",
                    "clientTaxId",
                    "paymentTerms",
                    "discountFixedAmount"
                  ]
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "quantity": {
                            "type": "number"
                          },
                          "unitPrice": {
                            "type": "number"
                          },
                          "discountRate": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100
                          }
                        },
                        "required": [
                          "description"
                        ],
                        "additionalProperties": false
                      }
                    }
                  ]
                },
                "evidence": {
                  "type": "string"
                }
              },
              "required": [
                "operation",
                "field"
              ],
              "additionalProperties": false
            }
          },
          "clarifications": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "enum": [
                    "businessName",
                    "clientName",
                    "invoiceNumber",
                    "issueDate",
                    "dueDate",
                    "lineItems",
                    "currency",
                    "senderAddress",
                    "senderEmail",
                    "senderPhone",
                    "clientAddress",
                    "clientEmail",
                    "clientPhone",
                    "subject",
                    "businessServices",
                    "taxRate",
                    "notesAndTerms",
                    "accountDetails",
                    "locale",
                    "dateFormat",
                    "taxStatus",
                    "discountRate",
                    "paymentMethod",
                    "senderTaxId",
                    "clientTaxId",
                    "paymentTerms",
                    "discountFixedAmount"
                  ]
                },
                "rawValue": {
                  "type": "string"
                },
                "suggestedValue": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "rawValue",
                "suggestedValue",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "requestField": {
            "type": "string",
            "enum": [
              "businessName",
              "clientName",
              "invoiceNumber",
              "issueDate",
              "dueDate",
              "lineItems",
              "currency",
              "senderAddress",
              "senderEmail",
              "senderPhone",
              "clientAddress",
              "clientEmail",
              "clientPhone",
              "subject",
              "businessServices",
              "taxRate",
              "notesAndTerms",
              "accountDetails",
              "locale",
              "dateFormat",
              "taxStatus",
              "discountRate",
              "paymentMethod",
              "senderTaxId",
              "clientTaxId",
              "paymentTerms",
              "discountFixedAmount"
            ]
          },
          "slots": {
            "type": "object",
            "properties": {
              "businessName": {
                "type": "string",
                "description": "business or company name"
              },
              "clientName": {
                "type": "string",
