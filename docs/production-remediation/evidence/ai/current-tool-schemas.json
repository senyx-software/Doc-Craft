  {
    "type": "function",
    "function": {
      "name": "propose_language_correction",
      "description": "Suggest corrected grammar or spelling in notes/subject. Preserve names, contact details, identifiers and numeric facts. Use literal original text from the current message, or the exact saved field only when proofreading that field was explicitly requested. Use field null when the intended field is unknown. The backend persists a confirmation before changing meaning.",
      "parameters": {
        "type": "object",
        "properties": {
          "field": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "notesAndTerms",
              "subject",
              null
            ]
          },
          "original": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "suggested": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "field",
          "original",
          "suggested",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  }
