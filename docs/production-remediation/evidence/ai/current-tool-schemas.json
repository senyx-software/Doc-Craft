                    "description"
                  ],
                  "additionalProperties": false
                }
              },
              "currency": {
                "type": "string",
                "description": "currency"
              },
              "senderAddress": {
                "type": "string",
                "description": "business address"
              },
              "senderEmail": {
                "type": "string",
                "description": "business email"
              },
              "senderPhone": {
                "type": "string",
                "description": "business phone"
              },
              "clientAddress": {
                "type": "string",
                "description": "client address"
              },
              "clientEmail": {
                "type": "string",
                "description": "client email"
              },
              "clientPhone": {
                "type": "string",
                "description": "client phone"
              },
              "subject": {
                "type": "string",
                "description": "project or service description"
              },
              "businessServices": {
                "type": "string",
                "description": "business services"
              },
              "taxRate": {
                "type": "number",
                "description": "tax rate"
              },
              "notesAndTerms": {
                "type": "string",
                "description": "notes and terms"
              },
              "accountDetails": {
                "type": "string",
                "description": "bank account details"
              },
              "locale": {
                "type": "string",
                "description": "document locale"
              },
              "dateFormat": {
                "type": "string",
                "description": "date format"
              },
              "taxStatus": {
                "type": "string",
                "description": "tax applicability"
              },
              "discountRate": {
                "type": "number",
                "description": "discount rate"
              },
              "paymentMethod": {
