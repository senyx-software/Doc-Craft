              },
              "discountFixedAmount": {
                "type": "number",
                "description": "fixed discount amount"
              }
            },
            "additionalProperties": false
          },
          "evidence": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "clear": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "businessName",
                "clientName",
                "invoiceNumber",
                "issueDate",
                "dueDate",
                "lineItems",
                "currency",
                "senderAddress",
                "senderEmail",
                "senderPhone",
                "clientAddress",
                "clientEmail",
                "clientPhone",
                "subject",
                "businessServices",
                "taxRate",
                "notesAndTerms",
                "accountDetails",
                "locale",
                "dateFormat",
                "taxStatus",
                "discountRate",
                "paymentMethod",
                "senderTaxId",
                "clientTaxId",
                "paymentTerms",
                "discountFixedAmount"
              ]
            }
          },
          "evidenceSource": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "skip": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "itemOperations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "operation": {
                  "enum": [
                    "add",
                    "update",
                    "remove"
                  ]
                },
                "id": {
                  "type": "string"
                },
                "item": {
                  "type": "object",
                  "properties": {
                    "description": {
                      "type": "string"
                    },
                    "quantity": {
                      "type": "number"
                    },
                    "unitPrice": {
                      "type": "number"
                    },
                    "discountRate": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    }
                  }
                }
              },
              "required": [
