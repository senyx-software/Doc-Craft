    "postgres": {
      "ports": null,
      "networks": [
        "backend"
      ],
      "mem_limit": "1536m",
      "cpus": 1.5,
      "restart": "unless-stopped",
      "healthcheck": {
        "test": [
          "CMD",
          "pg_isready",
          "-U",
          "postgres",
          "-d",
          "${POSTGRES_DB:?}"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 12
      },
      "depends_on": null,
      "profiles": null
    },
    "redis": {
      "ports": null,
      "networks": [
        "backend"
      ],
      "mem_limit": "384m",
      "cpus": 0.5,
      "restart": "unless-stopped",
      "healthcheck": {
        "test": [
          "CMD",
          "redis-cli",
          "--tls",
          "--cacert",
          "/run/secrets/ca.crt",
          "--user",
          "health",
          "ping"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 12
      },
      "depends_on": null,
      "profiles": null
    },
    "edge": {
      "ports": [
        "80:80",
        "443:443"
      ],
      "networks": [
        "backend",
        "egress"
      ],
      "mem_limit": "128m",
      "cpus": 0.5,
      "restart": "unless-stopped",
      "healthcheck": {
        "test": [
          "CMD",
          "caddy",
          "validate",
          "--config",
          "/etc/caddy/Caddyfile"
        ],
        "interval": "30s",
        "timeout": "5s",
        "retries": 3
      },
      "depends_on": {
        "gateway": {
          "condition": "service_healthy"
        },
        "admin-api": {
          "condition": "service_healthy"
        },
        "user-ui": {
          "condition": "service_healthy"
        },
        "admin-ui": {
          "condition": "service_healthy"
        }
      },
      "profiles": null
    },
    "ollama": {
      "ports": null,
      "networks": [
        "inference",
        "model-egress"
      ],
      "mem_limit": "${OLLAMA_MEMORY_MB:-6144}m",
      "cpus": "${OLLAMA_CPUS:-2}",
      "restart": "unless-stopped",
      "healthcheck": {
        "test": [
          "CMD",
          "ollama",
          "list"
        ],
        "interval": "30s",
        "timeout": "10s",
        "retries": 3,
        "start_period": "30s"
      },
      "depends_on": null,
      "profiles": [
        "local-ai"
      ]
    },
