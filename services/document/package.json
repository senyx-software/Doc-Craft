{
  "name": "doccraft-document",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"python -m uvicorn app.main:app --host 0.0.0.0 --port 3013 --reload --reload-dir app --env-file document.env\" \"node puppeteer/start.cjs --development\"",
    "build": "tsc",
    "start": "concurrently \"./.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 3013 --env-file document.env\" \"node puppeteer/start.cjs\"",
    "db:generate": "echo no-schema",
    "db:migrate": "echo no-schema",
    "db:migrate:dev": "echo no-schema"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.7",
    "ioredis": "^5.11.1",
    "jose": "^5.10.0",
    "puppeteer": "^25.14.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "concurrently": "^8.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
