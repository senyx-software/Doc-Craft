# Copy to a private reviewed backend.tf after selecting state infrastructure.
# Example only: use short-lived environment credentials, never access_key here.
terraform {
  backend "s3" {
    bucket       = "REPLACE_WITH_PRIVATE_STATE_BUCKET"
    key          = "doccraft/production.tfstate"
    region       = "REPLACE_WITH_STATE_REGION"
    encrypt      = true
    use_lockfile = true
    kms_key_id   = "REPLACE_WITH_APPROVED_KMS_KEY_ARN"
  }
}
