  "financial": {
    "discountFields": [
      "discountRate",
      "discountFixedAmount"
    ],
    "discountOrder": "line_item_then_document_then_tax",
    "fixedDiscountMaximum": "subtotal",
    "itemDiscountField": "discountRate",
    "lineItemCalculations": {
      "grossTotal": {
        "op": "multiply",
        "args": [
          {
            "ref": "quantity"
          },
          {
            "ref": "unitPrice"
          }
        ]
      },
      "discountAmount": {
        "op": "percent",
        "args": [
          {
            "ref": "grossTotal"
          },
          {
            "ref": "discountRate",
            "validated": true,
            "fallback": 0
          }
        ]
      },
      "total": {
        "op": "subtract",
        "args": [
          {
            "ref": "grossTotal"
          },
          {
            "ref": "discountAmount"
          }
        ]
      }
    },
    "documentCalculations": {
      "subtotal": {
        "op": "sumItems",
        "field": "total"
      },
      "discountAmount": {
        "op": "coalesce",
        "args": [
          {
            "op": "validFixed",
            "args": [
              {
                "ref": "discountFixedAmount"
              },
              {
                "ref": "subtotal"
              }
            ]
          },
          {
            "op": "percent",
            "args": [
              {
                "ref": "subtotal"
              },
              {
                "ref": "discountRate",
                "validated": true,
                "fallback": 0
              }
            ]
          }
