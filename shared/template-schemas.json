    "invoice-classic": {
      "id": "invoice-classic",
      "name": "Classic Invoice",
      "type": "invoice",
      "variant": "classic",
      "description": "Standard business invoice template",
      "slots": [
        "invoiceNumber",
        "issueDate",
        "dueDate",
        "senderName",
        "senderEmail",
        "senderPhone",
        "senderAddress",
        "clientName",
        "clientCompany",
        "clientAddress",
        "lineItems",
        "subtotal",
        "taxRate",
        "taxAmount",
        "totalAmount",
        "notes",
        "paymentInstructions",
        "logo"
      ],
      "schema": {
        "required": [
          "senderAddress",
          "clientAddress",
          "senderEmail",
          "senderPhone"
        ],
        "conditional": [
          {
            "field": "accountDetails",
            "whenField": "paymentMethod",
            "values": [
              "bank transfer",
              "cheque"
            ]
          },
          {
            "field": "taxRate",
            "whenField": "taxStatus",
            "values": [
              "taxable"
            ]
          }
